{
  "name": "novatrade-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:rest-api": "concurrently --kill-others -n frontend,rest-api \"npm:serve:rest-api\" \"npm:mock-rest\"",
    "start:graphql-api": "concurrently --kill-others -n frontend,graphql-api \"npm:serve:graphql-api\" \"npm:mock-graphql\"",
    "mock-rest": "node development-server/rest/server.mjs",
    "mock-graphql": "node development-server/graphql/server.mjs",
    "serve": "ng serve",
    "serve:rest-api": "ng serve --configuration=rest-api",
    "serve:graphql-api": "ng serve --configuration=graphql-api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "reset:development-db": "node e2e/scripts/reset-development-db.mjs",
    "e2e": "npm run e2e:rest",
    "e2e:rest": "npm run reset:development-db && playwright test --config=e2e/config/playwright.rest.config.ts",
    "e2e:graphql": "npm run reset:development-db && playwright test --config=e2e/config/playwright.graphql.config.ts",
    "e2e:ui": "npm run reset:development-db && playwright test --ui",
    "e2e:rest:ui": "npm run reset:development-db && playwright test --ui --config=e2e/config/playwright.rest.config.ts",
    "e2e:graphql:ui": "npm run reset:development-db && playwright test --ui --config=e2e/config/playwright.graphql.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "concurrently": "^10.0.5",
    "graphql": "^17.0.2",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
